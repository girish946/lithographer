{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lithographer",
  "version": "0.1.0",
  "identifier": "com.girish.lithographer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "lithographer",
        "width": 920,
        "height": 720,
        "minWidth": 300,
        "minHeight": 360,
        "resizable": true,
         "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "binaries/litho"
    ]
  }
}
